<Window x:Class="Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Het Mysterie van de Avondschool" Height="680" Width="1040"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="#1E1E24" Focusable="True" />

        <!-- Math Question Dialog Overlay -->
        <Grid x:Name="QuizOverlay" Visibility="Collapsed" Background="#AA000000">
            <Border Background="#2D2D3A" CornerRadius="12" Width="380" Height="230" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BorderBrush="#FFD700" BorderThickness="2">
                <StackPanel Margin="20">
                    <TextBlock Text="🔒 Deur Vergrendeld" Foreground="#FFD700" 
                               FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock x:Name="QuizQuestionText" Text="Los de som op:" Foreground="White" 
                               FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBox x:Name="QuizAnswerInput" Width="140" Height="34" FontSize="16" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                             KeyDown="QuizAnswerInput_KeyDown"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Openen" Width="110" Height="32" Click="SubmitAnswer_Click" 
                                Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Button Content="Annuleren" Width="90" Height="32" Click="CancelQuiz_Click" 
                                Background="#F44336" Foreground="White"/>
                    </StackPanel>

                    <TextBlock x:Name="QuizFeedbackText" Foreground="#FF5252" 
                               FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>